{
  "data_source": "UCI Bank Marketing \u2014 bank-additional-full.csv (41,188 historical contact records)",
  "chosen_model": "random_forest",
  "validation_metrics": {
    "logistic_regression": {
      "roc_auc": 0.5879,
      "pr_auc": 0.1474,
      "precision": 0.0533,
      "recall": 0.0049,
      "f1": 0.009,
      "brier": 0.1497
    },
    "random_forest": {
      "roc_auc": 0.5913,
      "pr_auc": 0.1613,
      "precision": 0.1548,
      "recall": 0.0296,
      "f1": 0.0497,
      "brier": 0.1606
    }
  },
  "held_out_test_metrics": {
    "roc_auc": 0.6794,
    "pr_auc": 0.4895,
    "precision": 0.4748,
    "recall": 0.4791,
    "f1": 0.477,
    "brier": 0.2114
  },
  "chronological_split": {
    "train": 26772,
    "validation": 6178,
    "test": 8238
  },
  "predictor_columns": [
    "age",
    "pdays",
    "previous",
    "emp.var.rate",
    "cons.price.idx",
    "cons.conf.idx",
    "euribor3m",
    "nr.employed",
    "job",
    "marital",
    "education",
    "default",
    "housing",
    "loan",
    "poutcome"
  ],
  "excluded_contact_time_columns": [
    "duration",
    "campaign",
    "contact",
    "month",
    "day_of_week"
  ],
  "caveat": "Historical contact response prediction, not causal campaign uplift, credit approval, or unique customer scoring."
}
